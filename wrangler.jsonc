{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gulbar",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "DEMO_MODE": "false", "APP_URL": "https://gulbar.bella-rose.workers.dev", "PENDING_EXPIRY_MINUTES": "30" },
  "d1_databases": [{ "binding": "DB", "database_name": "gulbar-live", "database_id": "65fdffc5-63df-4d4e-a01f-5ba5d7dbe620", "migrations_dir": "cloudflare/migrations" }],
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } }, { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
